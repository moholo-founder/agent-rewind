{
  "name": "backstop",
  "version": "0.1.0",
  "private": true,
  "description": "Flight recorder + undo button for AI agents: an MCP interception proxy with journaling, snapshots, policy gating, kill switch, and rewind.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "demo": "pnpm -r build && pnpm --filter @backstop/demo demo"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.15.4"
}
