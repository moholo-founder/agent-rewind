{
  "name": "agent-rewind",
  "version": "0.1.0",
  "description": "Flight recorder + undo button for AI agents. MCP interception proxy: journals every tool call, snapshots state before destructive actions, holds oversized ones for approval, and gives operators per-action Undo, Rewind-to-T, and a kill switch.",
  "keywords": ["mcp", "model-context-protocol", "ai-agents", "safety", "undo", "audit"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moholo-founder/agent-rewind.git"
  },
  "type": "module",
  "bin": {
    "agent-rewind": "dist/cli.js"
  },
  "files": ["dist", "web", "README.md"],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@agentrewind/api": "workspace:^",
    "@agentrewind/connectors": "workspace:^",
    "@agentrewind/core": "workspace:^",
    "@agentrewind/proxy": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  }
}
